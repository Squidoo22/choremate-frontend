# Базовий URL бекенду. За замовчуванням — відносний "/api/v1", який
# проксується на реальний бекенд (Vite у dev, Vercel у проді), тож CORS не заважає.
# Зазвичай цю змінну можна не задавати. Задайте лише, щоб бити в бекенд напряму:
# VITE_API_URL=https://choremate-backend-liart.vercel.app/api/v1

# Режим мок-даних. true — застосунок працює без бекенду.
# false — реальний API (auth, households, tasks).
VITE_USE_MOCKS=false

# Базовий URL бекенду (використовується, коли моки вимкнено).
# Прод-бекенд ChoreMate:
VITE_API_URL=https://choremate-backend-liart.vercel.app/api/v1

# Режим мок-даних. true (за замовчуванням) — застосунок працює без бекенду.
# Виставте false, щоб працювати з реальним API (auth, households, tasks).
VITE_USE_MOCKS=false
